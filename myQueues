
/**
 * A queue of ints backed by a fixed size circular array.
 * Elements come off in first in, first out order.
 */
public class MyQueue
{
    // the queue wraps around the end of the array, so the front can be any index
    private int[] myQueue;
    // number of elements in the queue
    private int count;
    // index of the front element
    private int frontIdx;
 
    /**
     * Constructs a queue that can hold 100 elements.
     */
    public MyQueue()
    {
        myQueue = new int[100];
        count = 0;
        frontIdx = 0;
    }
 
    /**
     * Constructs a queue that can hold maxSize elements.
     *
     * @param maxSize the maximum number of elements the queue can hold
     */
    public MyQueue(int maxSize)
    {
        myQueue = new int[maxSize];
        count = 0;
        frontIdx = 0;
    }
 
    /**
     * Indicates whether the queue contains any elements.
     *
     * @return true if the queue is empty, false otherwise
     */
    public boolean isEmpty()
    {
        return count == 0;
    }
 
    /**
     * Reads the element at the front of the queue without removing it.
     *
     * @return the element at the front, or -1 if the queue is empty
     */
    public int front()
    {
        // firstOut holds the value to return, -1 means nothing to give back
        int firstOut = -1;
        if (isEmpty() == false)
        {
            firstOut = myQueue[frontIdx];
        }
        return firstOut;
    }
 
    /**
     * Returns the number of elements stored in the queue.
     *
     * @return the number of elements in the queue
     */
    public int size()
    {
        return count;
    }
 
    /**
     * Indicates whether the queue has used up all of its storage.
     *
     * @return true if the queue is full, false otherwise
     */
    public boolean isFull()
    {
        return count == myQueue.length;
    }
 
    /**
     * Returns the contents of the queue from front to back.
     *
     * @return the elements of the queue separated by spaces, front first
     */
    public String toString()
    {
        String result = "";
        for (int i = 0; i < count; i++)
        {
            result += myQueue[(frontIdx + i) % myQueue.length] + " ";
        }
        return result;
    }
 
    /**
     * Adds an element to the back of the queue.
     * Does nothing if the queue is full.
     *
     * @param element the value to add
     */
    public void enqueue(int element)
    {
        if (isFull() == false)
        {
            // the back is the first open slot after the front element, wrapping around
            myQueue[(frontIdx + count) % myQueue.length] = element;
            count++;
        }
    }
 
    /**
     * Removes an element from the front of the queue.
     *
     * @return the element that was at the front, or -1 if the queue is empty
     */
    public int dequeue()
    {
        // firstOut holds the value to return, -1 means nothing to give back
        int firstOut = -1;
        if (isEmpty() == false)
        {
            firstOut = myQueue[frontIdx];
            // the old front stays in the array but no longer counts
            frontIdx = (frontIdx + 1) % myQueue.length;
            count--;
        }
        return firstOut;
    }
}
 
